# direnv config — exported automatically when you cd into this directory
# (requires `brew install direnv` + the shell hook).
#
# Sentry DSN baked into `make build`. DSNs are public identifiers by
# design, so this is safe to commit — but feel free to move it to
# .envrc.local (already gitignored) if you'd rather not share it across
# forks.
export SENTRY_DSN="https://0a2aad426c5b03f26e243da64d2f5965@o4508150475390976.ingest.de.sentry.io/4511441278074960"
